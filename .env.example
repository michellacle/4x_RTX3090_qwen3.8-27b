# Qwen3.8-27B Server Configuration (4x RTX 3090)
# Copy to .env and edit, or export these before running serve.sh

# Model path (must exist on disk)
# MODEL_PATH=/home/michel/models/qwen3.8-27b-bf16
# MODEL_QUANTIZATION=bf16  # bf16 | q8 | q6

# Server
VLLM_PORT=8000
VLLM_TP=4
VLLM_GPU_MEM=0.90
VLLM_MAX_LEN=262144
VLLM_MAX_SEQS=2
VLLM_SPECULATIVE_TOKENS=3
VLLM_ENABLE_PREFIX_CACHING=1

# Runtime profile tracking (written automatically by install.sh / set-profile.sh)
# RUNTIME_PROFILE=default

# Pre-flight only (don't start server, just check GPU/venv)
# VLLM_CHECK_ONLY=1
