# Qwen3.8-27B Server Configuration (4x RTX 3090)
# Copy to .env and edit, or export these before running serve.sh

# Model path (must exist on disk)
# MODEL_PATH=/home/michel/models/qwen3.8-27b-bf16

# Server
VLLM_PORT=8000
VLLM_TP=4
VLLM_GPU_MEM=0.90
VLLM_MAX_LEN=262144
VLLM_MAX_SEQS=2

# Pre-flight only (don't start server, just check GPU/venv)
# VLLM_CHECK_ONLY=1
